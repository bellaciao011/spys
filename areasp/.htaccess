DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Short links (legado): /areasp/r/s → /areasp/r/index.php?c=s
    RewriteRule ^r/([A-Za-z0-9_-]+)/?$ r/index.php?c=$1 [L,QSA]

    # URLs antigas -> /areasp/
    RewriteRule ^meb/membros/?(.*)$ /areasp/$1 [L,R=301]
    RewriteRule ^meb/chat/?(.*)$ /areasp/chat/$1 [L,R=301]
    RewriteRule ^meb/ajuda/?(.*)$ /areasp/ajuda/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
